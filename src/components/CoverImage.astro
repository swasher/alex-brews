---
import type { Tone } from '../lib/tones';

interface Props {
	alt: string;
	tone?: Tone;
	label?: string;
	class?: string;
}

const { alt, tone = 'amber', label, class: className } = Astro.props;

const tones: Record<Tone, string> = {
	amber: 'from-[#8a4a26] via-[#4a2515] to-[#160d08]',
	olive: 'from-[#4b563a] via-[#2b3524] to-[#120c09]',
	plum: 'from-[#5b3a44] via-[#38232b] to-[#120c09]',
	slate: 'from-[#3f4e52] via-[#283234] to-[#120c09]',
	sand: 'from-[#7f6243] via-[#4a3423] to-[#120c09]',
};

const letter = label?.trim().charAt(0).toUpperCase();
---

<div
	class:list={['relative isolate overflow-hidden bg-gradient-to-br', tones[tone], className]}
	role="img"
	aria-label={alt}
>
	<div class="grain absolute inset-0 opacity-25" aria-hidden="true"></div>

	<svg
		class="absolute -right-1/4 top-1/2 h-[130%] w-[130%] -translate-y-1/2 text-crema-50/10"
		viewBox="0 0 200 200"
		fill="none"
		aria-hidden="true"
	>
		<circle cx="100" cy="100" r="92" stroke="currentColor" stroke-width="0.6"></circle>
		<circle cx="100" cy="100" r="68" stroke="currentColor" stroke-width="0.6"></circle>
		<circle cx="100" cy="100" r="44" stroke="currentColor" stroke-width="0.6"></circle>
		<ellipse cx="100" cy="100" rx="24" ry="38" stroke="currentColor" stroke-width="0.8" transform="rotate(-24 100 100)"
		></ellipse>
	</svg>

	{
		letter && (
			<span
				class="pointer-events-none absolute inset-0 flex select-none items-center justify-center font-display text-[clamp(6rem,18vw,14rem)] italic leading-none text-crema-50/10"
				aria-hidden="true"
			>
				{letter}
			</span>
		)
	}

	{
		label && (
			<span class="absolute bottom-4 left-4 text-[10px] font-medium uppercase tracking-[0.28em] text-crema-50/70">
				{label}
			</span>
		)
	}
</div>
