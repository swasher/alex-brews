---
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-crema-50/10">
	<div
		class="mx-auto flex max-w-7xl flex-col gap-2 px-5 py-8 sm:flex-row sm:items-baseline sm:justify-between sm:px-8"
	>
		<p class="font-display text-xl text-crema-50">Alex Brews</p>
		<p class="text-[11px] uppercase tracking-[0.18em] text-mocha-500">
			Личный кофейный журнал · {year}
		</p>
	</div>
</footer>
